# Copy to .env and fill in real values for a production (AWS/Redshift) run.
# Never commit the real .env file.

AWS_REGION=us-east-1
RAW_BUCKET=retail-dw-raw
CURATED_BUCKET=retail-dw-curated
RAW_PREFIX=orders/

REDSHIFT_HOST=your-cluster.xxxxx.us-east-1.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DB=retail_dw
REDSHIFT_USER=etl_service
REDSHIFT_PASSWORD=change-me
REDSHIFT_COPY_ROLE_ARN=arn:aws:iam::123456789012:role/redshift-copy-role

# api/db.py: "local" (SQLite demo) or "redshift" (production)
DATABASE_MODE=local
